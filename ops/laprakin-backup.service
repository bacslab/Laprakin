[Unit]
Description=Encrypted Laprakin application backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=laprakin
Group=laprakin
WorkingDirectory=/opt/laprakin
ExecStart=/opt/laprakin/ops/backup-laprakin.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
