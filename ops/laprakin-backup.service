[Unit]
Description=Encrypted Laprakin application backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Compose membaca server/.env yang sengaja dijaga root:root 0600. Backup sudah
# memiliki akses penuh ke data sensitif, jadi jalankan unit sebagai root tanpa
# melonggarkan permission secret aplikasi.
User=root
Group=root
WorkingDirectory=/opt/laprakin
# Dipanggil lewat bash karena deploy dari archive dapat menghapus bit executable.
ExecStart=/bin/bash /opt/laprakin/ops/backup-laprakin.sh
Environment=LAPRAKIN_BACKUP_DIR=/var/backups/laprakin
Environment=LAPRAKIN_BACKUP_KEY_FILE=/var/backups/laprakin/.backup-key
Environment=LAPRAKIN_BACKUP_RETENTION_DAYS=30
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
