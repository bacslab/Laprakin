[Unit]
Description=Run the Laprakin operational watchdog every 15 minutes

[Timer]
# OnCalendar dipakai (bukan OnUnitActiveSec) agar jadwal berikutnya selalu
# terhitung pasti dan terlihat di `systemctl list-timers`.
OnCalendar=*:0/15
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
