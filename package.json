{
  "name": "laprakin-fullstack",
  "version": "21.0.0-qris",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev --workspace @laprakin/server\" \"npm run dev --workspace @laprakin/client\"",
    "build": "npm run email:ops:build && npm run build --workspace @laprakin/client",
    "start": "npm run start --workspace @laprakin/server",
    "test": "node --test \"server/test/*.test.mjs\"",
    "lint": "eslint server/src/emails server/emails ops/laprakin-email-renderer-entry.mjs scripts/build-ops-email-renderer.mjs scripts/email-render-check.mjs server/test/email-templates.test.mjs",
    "typecheck": "tsc -p tsconfig.email.json",
    "email:dev": "email dev --dir server/emails",
    "email:ops:build": "node scripts/build-ops-email-renderer.mjs",
    "email:render:check": "node scripts/email-render-check.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "start:prod": "node scripts/start-production.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:ai-auth": "node scripts/ai-auth-check.mjs",
    "test:report-workflow": "node scripts/chat-workflow-check.mjs",
    "test:template-docx": "node scripts/template-docx-check.mjs",
    "test:workflow-api": "node scripts/workflow-api-check.mjs",
    "test:admin-ops": "node scripts/admin-ops-check.mjs",
    "test:ai-live": "node scripts/ai-live-check.mjs",
    "bench:ai": "node scripts/bench-nararouter.mjs",
    "prepare:production-env": "node scripts/prepare-production-env.mjs",
    "test:production-config": "node scripts/production-config-check.mjs",
    "verify:production": "node scripts/production-readiness.mjs",
    "test:audit": "npm audit --omit=dev",
    "migrate:v4": "node scripts/migrate-runtut-to-laprakin.mjs",
    "setup": "node scripts/setup.mjs",
    "test:payments": "node scripts/qris-payment-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-email/ui": "^6.9.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.28",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^17.4.0",
    "react-email": "^6.9.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "lenis": "^1.1.18"
  }
}
