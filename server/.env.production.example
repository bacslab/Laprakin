NODE_ENV=production
SERVE_STATIC=true
PORT=4000

# Ganti dengan domain production yang sudah terhubung ke hosting.
APP_URL=https://laprakin.app
API_URL=https://laprakin.app
ALLOWED_ORIGINS=https://laprakin.app
TRUST_PROXY_HOPS=1
SESSION_DAYS=30

# Buat tiga secret acak, unik, minimal 32 karakter. Jangan commit nilainya.
JWT_SECRET=replace-with-random-secret
DEVICE_HMAC_SECRET=replace-with-different-random-secret
TOKEN_HMAC_SECRET=replace-with-another-random-secret
ADMIN_EMAIL=admin@laprakin.app

AI_REQUIRED=true
NARAROUTER_API_KEY=replace-with-nararouter-api-key
NARAROUTER_BASE_URL=https://router.bynara.id/v1
NARAROUTER_MAX_RPM=8
NARAROUTER_MAX_CONCURRENCY=2
AI_MODEL_DOCUMENT=auto
AI_MODEL_VISION=auto
AI_MODEL_REVIEWER=auto
AI_MODEL_CHAT=auto
AI_CIRCUIT_FAILURE_THRESHOLD=4
AI_CIRCUIT_COOLDOWN_MS=30000
CLOUDFLARE_AI_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/google/gemma-4-26b-a4b-it
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
AI_MAX_REQUESTS_PER_HOUR=60
AI_MAX_REQUESTS_PER_DAY=5000
AI_CONTEXT_CHARACTERS=24000
AI_ATTACHMENT_CHARACTERS=18000
AI_OPERATIONAL_CONTEXT_TOKENS=220000

MANUAL_EMAIL_AUTH_ONLY=false
GOOGLE_OAUTH_REQUIRED=true
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://laprakin.app/api/auth/google/callback
GOOGLE_REQUEST_TIMEOUT_MS=10000

EMAIL_MODE=smtp
MAIL_FROM=Laprakin <noreply@mail.laprakin.app>
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=replace-with-resend-api-key

PAYMENTS_MODE=midtrans
MIDTRANS_ENVIRONMENT=production
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_SERVER_KEY=replace-with-midtrans-server-key
MIDTRANS_CLIENT_KEY=replace-with-midtrans-client-key
MIDTRANS_VERIFY_STATUS=true

MAX_UPLOAD_MB=20
MAX_FILES_PER_UPLOAD=12
MAX_FILES_PER_DOCUMENT=40
JOB_POLL_MS=750
JOB_MAX_ATTEMPTS=2
RETENTION_SWEEP_MINUTES=60

# Gunakan satu persistent disk pada hosting production.
LAPRAKIN_DATA_DIR=/var/data/laprakin/data
LAPRAKIN_UPLOAD_DIR=/var/data/laprakin/uploads
LAPRAKIN_PUBLIC_MEDIA_DIR=/var/data/laprakin/public-media

AZURE_STORAGE_CONNECTION_STRING=replace-with-azure-storage-connection-string
AZURE_BLOB_CONTAINER_NAME=user-documents

