# Local/no-NPM launcher defaults. Do not put real Midtrans or SMTP secrets in this file.
NODE_ENV=development
SERVE_STATIC=true
PORT=5173
APP_URL=http://localhost:5173
API_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
SESSION_DAYS=30

# AI calls only run from the server. Use a restricted/auth key and never expose it through VITE_*.
AI_REQUIRED=false
NARAROUTER_API_KEY=
NARAROUTER_BASE_URL=https://router.bynara.id/v1
NARAROUTER_MAX_RPM=8
NARAROUTER_MAX_CONCURRENCY=2
AI_MODEL_DOCUMENT=auto
AI_MODEL_VISION=auto
AI_MODEL_REVIEWER=auto
AI_MODEL_CHAT=auto
AI_CIRCUIT_FAILURE_THRESHOLD=4
AI_CIRCUIT_COOLDOWN_MS=30000
CLOUDFLARE_AI_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/google/gemma-4-26b-a4b-it
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
AI_MAX_REQUESTS_PER_HOUR=60
AI_MAX_REQUESTS_PER_DAY=5000
AI_CONTEXT_CHARACTERS=24000
AI_ATTACHMENT_CHARACTERS=18000
AI_OPERATIONAL_CONTEXT_TOKENS=220000

# Google OAuth Web application credentials.
MANUAL_EMAIL_AUTH_ONLY=true
GOOGLE_OAUTH_REQUIRED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
GOOGLE_REQUEST_TIMEOUT_MS=10000

# Development credentials are supplied by safe defaults in server/src/config.js.
# Use unique values and NODE_ENV=production in deployment.
# JWT_SECRET=
# DEVICE_HMAC_SECRET=
# TOKEN_HMAC_SECRET=
# ADMIN_EMAIL=admin@domain-kamu.id

# Transactional email. Production readiness requires SMTP and a non-localhost sender.
EMAIL_MODE=console
MAIL_FROM=Laprakin <noreply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Keep manual until Midtrans credentials are configured.
PAYMENTS_MODE=manual
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
